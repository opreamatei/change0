digraph "search" {
node [
  fontsize = "12"
];
    "node9" [ label = "search", shape = doubleoctagon ];
    "node10" [ label = "node", shape = doubleoctagon ];
    "node9" -> "node10"  // search -> node
    "node11" [ label = "hd", shape = doubleoctagon ];
    "node10" -> "node11"  // node -> hd
    "node5" [ label = "m", shape = septagon ];
    "node10" -> "node5" [ style = dotted ] // node -> m
    "node6" [ label = "util", shape = doubleoctagon ];
    "node10" -> "node6"  // node -> util
    "node7" [ label = "change-errors", shape = doubleoctagon ];
    "node6" -> "node7"  // util -> change-errors
    "node4" [ label = "jsonp", shape = doubleoctagon ];
    "node6" -> "node4"  // util -> jsonp
    "node4" -> "node5" [ style = dotted ] // jsonp -> m
    "node9" -> "node6"  // search -> util
}
