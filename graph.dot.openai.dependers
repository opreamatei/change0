digraph "openai" {
node [
  fontsize = "12"
];
    "node14" [ label = "openai", shape = doubleoctagon ];
    "node13" [ label = "deepsearchexecute", shape = doubleoctagon ];
    "node13" -> "node14"  // deepsearchexecute -> openai
    "node12" [ label = "change", shape = egg ];
    "node12" -> "node13" [ style = dotted ] // change -> deepsearchexecute
    "node17" [ label = "deepsearchsession", shape = doubleoctagon ];
    "node17" -> "node13"  // deepsearchsession -> deepsearchexecute
    "node12" -> "node17" [ style = dotted ] // change -> deepsearchsession
    "node20" [ label = "goal", shape = doubleoctagon ];
    "node20" -> "node17"  // goal -> deepsearchsession
    "node12" -> "node20" [ style = dotted ] // change -> goal
    "node23" [ label = "http-server", shape = doubleoctagon ];
    "node23" -> "node20"  // http-server -> goal
    "node12" -> "node23" [ style = dotted ] // change -> http-server
    "node28" [ label = "ui", shape = doubleoctagon ];
    "node28" -> "node23"  // ui -> http-server
    "node12" -> "node28" [ style = dotted ] // change -> ui
    "node28" -> "node20"  // ui -> goal
    "node21" [ label = "goal-ai", shape = doubleoctagon ];
    "node21" -> "node17"  // goal-ai -> deepsearchsession
    "node20" -> "node21"  // goal -> goal-ai
    "node28" -> "node17"  // ui -> deepsearchsession
    "node17" -> "node14"  // deepsearchsession -> openai
    "node21" -> "node14"  // goal-ai -> openai
    "node20" -> "node14"  // goal -> openai
    "node24" [ label = "inputprocessor", shape = doubleoctagon ];
    "node24" -> "node14"  // inputprocessor -> openai
    "node23" -> "node24"  // http-server -> inputprocessor
    "node12" -> "node24" [ style = dotted ] // change -> inputprocessor
    "node28" -> "node24"  // ui -> inputprocessor
    "node27" [ label = "mockopenai", shape = doubleoctagon ];
    "node27" -> "node14"  // mockopenai -> openai
    "node12" -> "node27" [ style = dotted ] // change -> mockopenai
    "node28" -> "node27"  // ui -> mockopenai
    "node12" -> "node14" [ style = dotted ] // change -> openai
}
