    "node21" -> "node14"  // goal-ai -> openai
    "node21" -> "node6"  // goal-ai -> util
    "node20" -> "node8"  // goal -> goal-info
    "node20" -> "node3"  // goal -> goal-util
    "node20" -> "node4"  // goal -> jsonp
    "node20" -> "node10"  // goal -> node
    "node20" -> "node14"  // goal -> openai
    "node20" -> "node6"  // goal -> util
    "node12" -> "node18" [ style = dotted ] // change -> graphengine
    "node22" [ label = "graphexport", shape = doubleoctagon ];
    "node12" -> "node22" [ style = dotted ] // change -> graphexport
    "node22" -> "node10"  // graphexport -> node
    "node22" -> "node6"  // graphexport -> util
    "node12" -> "node11" [ style = dotted ] // change -> hd
    "node23" [ label = "http-server", shape = doubleoctagon ];
    "node12" -> "node23" [ style = dotted ] // change -> http-server
    "node23" -> "node20"  // http-server -> goal
    "node23" -> "node22"  // http-server -> graphexport
    "node24" [ label = "inputprocessor", shape = doubleoctagon ];
    "node23" -> "node24"  // http-server -> inputprocessor
    "node25" [ label = "json2graph", shape = doubleoctagon ];
    "node24" -> "node25"  // inputprocessor -> json2graph
    "node25" -> "node4"  // json2graph -> jsonp
    "node25" -> "node10"  // json2graph -> node
    "node25" -> "node6"  // json2graph -> util
    "node24" -> "node4"  // inputprocessor -> jsonp
    "node24" -> "node10"  // inputprocessor -> node
    "node24" -> "node14"  // inputprocessor -> openai
    "node24" -> "node6"  // inputprocessor -> util
    "node23" -> "node10"  // http-server -> node
    "node26" [ label = "pthread", shape = septagon ];
    "node23" -> "node26"  // http-server -> pthread
    "node23" -> "node6"  // http-server -> util
    "node12" -> "node24" [ style = dotted ] // change -> inputprocessor
    "node12" -> "node25" [ style = dotted ] // change -> json2graph
    "node12" -> "node4" [ style = dotted ] // change -> jsonp
    "node27" [ label = "mockopenai", shape = doubleoctagon ];
    "node12" -> "node27" [ style = dotted ] // change -> mockopenai
    "node27" -> "node14"  // mockopenai -> openai
    "node12" -> "node19" [ style = dotted ] // change -> mocks
    "node12" -> "node10" [ style = dotted ] // change -> node
    "node12" -> "node14" [ style = dotted ] // change -> openai
    "node12" -> "node9" [ style = dotted ] // change -> search
    "node28" [ label = "ui", shape = doubleoctagon ];
    "node12" -> "node28" [ style = dotted ] // change -> ui
    "node28" -> "node17"  // ui -> deepsearchsession
    "node28" -> "node2"  // ui -> globals
    "node28" -> "node20"  // ui -> goal
    "node28" -> "node22"  // ui -> graphexport
    "node28" -> "node23"  // ui -> http-server
    "node28" -> "node24"  // ui -> inputprocessor
    "node28" -> "node27"  // ui -> mockopenai
    "node28" -> "node10"  // ui -> node
    "node28" -> "node6"  // ui -> util
    "node12" -> "node6" [ style = dotted ] // change -> util
