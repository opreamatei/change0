    "node8" -> "node3"  // goal-info -> goal-util
    "node0" -> "node4"  // aiaction -> jsonp
    "node9" [ label = "search", shape = doubleoctagon ];
    "node0" -> "node9"  // aiaction -> search
    "node10" [ label = "node", shape = doubleoctagon ];
    "node9" -> "node10"  // search -> node
    "node11" [ label = "hd", shape = doubleoctagon ];
    "node10" -> "node11"  // node -> hd
    "node10" -> "node5" [ style = dotted ] // node -> m
    "node10" -> "node6"  // node -> util
    "node9" -> "node6"  // search -> util
    "node0" -> "node6"  // aiaction -> util
    "node13" [ label = "deepsearchexecute", shape = doubleoctagon ];
    "node12" -> "node13" [ style = dotted ] // change -> deepsearchexecute
    "node13" -> "node0"  // deepsearchexecute -> aiaction
    "node13" -> "node1"  // deepsearchexecute -> comparsing
    "node13" -> "node4"  // deepsearchexecute -> jsonp
    "node14" [ label = "openai", shape = doubleoctagon ];
    "node13" -> "node14"  // deepsearchexecute -> openai
    "node15" [ label = "OpenSSL::Crypto", shape = septagon ];
    "node14" -> "node15" [ style = dotted ] // openai -> OpenSSL::Crypto
    "node16" [ label = "OpenSSL::SSL", shape = septagon ];
    "node14" -> "node16" [ style = dotted ] // openai -> OpenSSL::SSL
    "node16" -> "node15" [ style = dashed ] // OpenSSL::SSL -> OpenSSL::Crypto
    "node14" -> "node4"  // openai -> jsonp
    "node14" -> "node6"  // openai -> util
    "node17" [ label = "deepsearchsession", shape = doubleoctagon ];
    "node12" -> "node17" [ style = dotted ] // change -> deepsearchsession
    "node17" -> "node1"  // deepsearchsession -> comparsing
    "node17" -> "node13"  // deepsearchsession -> deepsearchexecute
    "node17" -> "node2"  // deepsearchsession -> globals
    "node18" [ label = "graphengine", shape = doubleoctagon ];
    "node17" -> "node18"  // deepsearchsession -> graphengine
    "node18" -> "node5" [ style = dotted ] // graphengine -> m
    "node18" -> "node10"  // graphengine -> node
    "node18" -> "node6"  // graphengine -> util
    "node17" -> "node4"  // deepsearchsession -> jsonp
    "node19" [ label = "mocks", shape = doubleoctagon ];
    "node17" -> "node19"  // deepsearchsession -> mocks
    "node19" -> "node10"  // mocks -> node
    "node19" -> "node6"  // mocks -> util
    "node17" -> "node14"  // deepsearchsession -> openai
    "node17" -> "node6"  // deepsearchsession -> util
    "node20" [ label = "goal", shape = doubleoctagon ];
    "node12" -> "node20" [ style = dotted ] // change -> goal
    "node20" -> "node17"  // goal -> deepsearchsession
    "node21" [ label = "goal-ai", shape = doubleoctagon ];
