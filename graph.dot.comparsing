digraph "comparsing" {
node [
  fontsize = "12"
];
    "node1" [ label = "comparsing", shape = doubleoctagon ];
    "node2" [ label = "globals", shape = doubleoctagon ];
    "node1" -> "node2"  // comparsing -> globals
    "node3" [ label = "goal-util", shape = doubleoctagon ];
    "node1" -> "node3"  // comparsing -> goal-util
    "node3" -> "node2"  // goal-util -> globals
    "node4" [ label = "jsonp", shape = doubleoctagon ];
    "node3" -> "node4"  // goal-util -> jsonp
    "node5" [ label = "m", shape = septagon ];
    "node4" -> "node5" [ style = dotted ] // jsonp -> m
    "node6" [ label = "util", shape = doubleoctagon ];
    "node3" -> "node6"  // goal-util -> util
    "node7" [ label = "change-errors", shape = doubleoctagon ];
    "node6" -> "node7"  // util -> change-errors
    "node6" -> "node4"  // util -> jsonp
    "node1" -> "node4"  // comparsing -> jsonp
    "node1" -> "node6"  // comparsing -> util
}
